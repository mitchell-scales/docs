            "pages": [
              "datasets",
              "activity-datasets",
              "sql-datasets",
              "time-datasets"
            ],
            "icon": "table"
          },
          {
            "group": "Journeys",
            "pages": [
              "journeys"
            ],
            "icon": "route"
          },
          {
            "group": "Models",
            "pages": [
              "metrics",
              "dimensions"
            ],
            "icon": "sigma"
          },
          {
            "group": "Workflows",
            "pages": [
              "workflows"
            ],
            "icon": "bolt"
          },
          {
            "group": "Infrastructure",
            "icon": "database",
            "pages": [
              "overview",
              "lineage",
              "streams",
              "activities",
              "transformations"
            ]
          },
          {
            "group": "Tasks",
            "expanded": true,
            "pages": [
              "tasks"
            ],
            "icon": "list-check"
          },
          {
            "group": "Agents",
            "pages": [
              "agents"
            ],
            "icon": "robot"
          }
        ],
        "icon": "layer-group"
